{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "Skill",
      "ToolSearch",
      "SendMessage",
      "ListAgents"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(dd if=/dev/zero*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Read(~/.ssh/*)",
      "Read(~/.aws/*)",
      "Read(~/.gnupg/*)"
    ],
    "ask": [
      "Bash(chmod 777 *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/full_boot.sh ] || exit 0; bash execution/hooks/full_boot.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/pre_compact_snapshot.sh ] && bash execution/hooks/pre_compact_snapshot.sh || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/post_compact_restore.sh ] || exit 0; bash execution/hooks/post_compact_restore.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/post_compact_inject.sh ] || exit 0; bash execution/hooks/post_compact_inject.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/compaction_backstop.sh ] && bash execution/hooks/compaction_backstop.sh || exit 0",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/permission_gate.sh ] || exit 0; bash execution/hooks/permission_gate.sh attended",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/permission_gate.sh ] || exit 0; bash execution/hooks/permission_gate.sh request",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/permission_gate.sh ] || exit 0; bash execution/hooks/permission_gate.sh notify",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "analyst|architect|designer|dev|docs|lead|maintainer|qa",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/subagent_stop.sh ] || exit 0; bash execution/hooks/subagent_stop.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/check_autonomy.sh ] || exit 0; bash execution/hooks/check_autonomy.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/verify_workspace.sh ] || exit 0; bash execution/hooks/verify_workspace.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "300000"
  },
  "autoCompactWindow": 400000,
  "sandbox": {
    "enabled": false,
    "credentials": {
      "files": [
        { "path": "~/.aws/credentials", "mode": "deny" },
        { "path": "~/.ssh/", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" }
      ],
      "envVars": [
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" }
      ]
    }
  }
}
