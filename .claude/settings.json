{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "Skill",
      "ToolSearch",
      "SendMessage",
      "ListAgents",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(test:*)",
      "Bash(echo:*)",
      "Bash(cd:*)",
      "Bash(jq:*)",
      "Bash(git:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(pnpm:*)",
      "Bash(make:*)",
      "Bash(codex:*)",
      "Bash(gws:*)",
      "Bash(curl:*)",
      "Bash(gcloud:*)",
      "Bash(gh:*)",
      "Bash(mkdir:*)",
      "Bash(chmod +x:*)",
      "Bash(bash:*)",
      "Bash(sh:*)",
      "Bash(tee:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(xargs:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(stat:*)",
      "Bash(date:*)",
      "Bash(env:*)",
      "Bash(which:*)",
      "Bash(command:*)",
      "Bash(nl:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(dd if=/dev/zero*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Read(~/.ssh/*)",
      "Read(~/.aws/*)",
      "Read(~/.gnupg/*)"
    ],
    "ask": [
      "Bash(chmod 777 *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/full_boot.sh ] || exit 0; bash execution/hooks/full_boot.sh"
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/session_start_away_report.sh ] || exit 0; bash execution/hooks/session_start_away_report.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/pre_compact_snapshot.sh ] && bash execution/hooks/pre_compact_snapshot.sh || true",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "input=$(cat); trigger=$(printf '%s' \"$input\" | python3 -c \"import sys,json; print(json.load(sys.stdin).get('compaction_trigger','unknown'))\" 2>/dev/null || echo 'unknown'); recent=$(git log --oneline -5 2>/dev/null | tr '\\n' '; ' || echo 'no git'); python3 execution/brain.py remember --summary \"Pre-compaction checkpoint ($trigger). Recent commits: $recent\" --tags \"compaction,checkpoint\" 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/post_compact_restore.sh ] || exit 0; bash execution/hooks/post_compact_restore.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/post_compact_inject.sh ] || exit 0; bash execution/hooks/post_compact_inject.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "[ -f docs/rules/inject_no_invention.sh ] || exit 0; bash docs/rules/inject_no_invention.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/harness_heartbeat.sh ] || exit 0; bash execution/hooks/harness_heartbeat.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/inject_pressure.sh ] || exit 0; bash execution/hooks/inject_pressure.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/compaction_nudge.sh ] || exit 0; bash execution/hooks/compaction_nudge.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/compaction_backstop.sh ] || exit 0; bash execution/hooks/compaction_backstop.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "analyst|architect|designer|dev|docs|lead|maintainer|qa",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/subagent_stop.sh ] || exit 0; bash execution/hooks/subagent_stop.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/check_autonomy.sh ] || exit 0; bash execution/hooks/check_autonomy.sh"
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/block_asq_in_loop.sh ] && bash execution/hooks/block_asq_in_loop.sh || exit 0"
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/require_contract_for_write.sh ] && bash execution/hooks/require_contract_for_write.sh || exit 0"
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/require_docs.sh ] || exit 0; bash execution/hooks/require_docs.sh"
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/require_maintainer.sh ] || exit 0; bash execution/hooks/require_maintainer.sh"
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/allow_in_project_bash.sh ] || exit 0; bash execution/hooks/allow_in_project_bash.sh"
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/require_research.sh ] && bash execution/hooks/require_research.sh || exit 0"
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/require_contract.sh ] && bash execution/hooks/require_contract.sh || exit 0"
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/require_dev_result.sh ] && bash execution/hooks/require_dev_result.sh || exit 0"
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/require_qa_report.sh ] && bash execution/hooks/require_qa_report.sh || exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/verify_workspace.sh ] || exit 0; bash execution/hooks/verify_workspace.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/require_maintainer.sh ] && bash execution/hooks/require_maintainer.sh || exit 0"
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/session_token_log.sh ] && bash execution/hooks/session_token_log.sh || exit 0",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/session_clean_exit_marker.sh ] && bash execution/hooks/session_clean_exit_marker.sh || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f docs/rules/inject_no_invention.sh ] || exit 0; bash docs/rules/inject_no_invention.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/subagent_start.sh ] && bash execution/hooks/subagent_start.sh || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/post_agent_loop_continue.sh ] && bash execution/hooks/post_agent_loop_continue.sh || exit 0"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/quota_death_checkpoint.sh ] && bash execution/hooks/quota_death_checkpoint.sh || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f execution/hooks/turn_end_stamp.sh ] && bash execution/hooks/turn_end_stamp.sh || exit 0",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "[ -f execution/hooks/blocker_scan.sh ] && bash execution/hooks/blocker_scan.sh || exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "PAI_CONTEXT_MODE": "coding",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000"
  },
  "cleanupPeriodDays": 30,
  "skipDangerousModePermissionPrompt": true,
  "autoCompactEnabled": true,
  "respondToBashCommands": false,
  "sandbox": {
    "credentials": {
      "files": [
        {
          "path": "~/.aws/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.ssh/",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        }
      ]
    },
    "enabled": false
  },
  "statusLine": {
    "type": "command",
    "command": "python3 execution/statusline.py"
  }
}
