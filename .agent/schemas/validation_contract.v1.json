{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Athanor Validation Contract v1",
  "description": "Pre-implementation correctness criteria written during /spec planning",
  "type": "object",
  "required": ["schema", "spec", "created_at", "assertions"],
  "properties": {
    "schema": {"type": "string", "const": "athanor.contract/v1"},
    "spec": {"type": "string", "description": "Path to the spec file this contract covers"},
    "created_at": {"type": "string", "format": "date-time"},
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "verify", "phase"],
        "properties": {
          "id": {"type": "string", "pattern": "^A[0-9]+$", "description": "e.g. A1, A2"},
          "description": {"type": "string", "description": "What must be true when done"},
          "verify": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["shell", "file_exists", "file_contains", "json_path", "handoff_field", "agent_review"],
                "description": "Dispatch key consumed by contract.py check"
              },
              "cmd": {"type": "string", "description": "Shell command to run (kind: shell)"},
              "expect_exit": {
                "type": "integer",
                "default": 0,
                "description": "Expected exit code (kind: shell)"
              },
              "path": {
                "type": "string",
                "description": "File path to check (kind: file_exists, file_contains, json_path)"
              },
              "pattern": {
                "type": "string",
                "description": "Regex pattern to search for (kind: file_contains)"
              },
              "jsonpath": {
                "type": "string",
                "description": "Dot-notation JSON path expression e.g. $.assertions (kind: json_path, handoff_field)"
              },
              "equals": {
                "description": "Expected value at jsonpath (kind: json_path)"
              },
              "rubric": {
                "type": "string",
                "description": "Review instructions for a QA agent (kind: agent_review)"
              }
            }
          },
          "severity": {
            "type": "string",
            "enum": ["blocker", "major", "minor"],
            "description": "Impact severity if this assertion fails"
          },
          "phase": {"type": "integer", "description": "Which spec phase this assertion validates"},
          "features": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Which spec features cover this assertion"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "pass", "fail", "skipped"],
            "default": "pending"
          },
          "qa_notes": {"type": "string", "description": "QA findings when verifying"}
        }
      }
    }
  }
}
