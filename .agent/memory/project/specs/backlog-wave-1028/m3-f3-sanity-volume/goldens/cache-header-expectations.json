{
  "_comment": "Expected Cache-Control by route class once the site is LAUNCHED (SITE_PUBLIC_LAUNCH=true, no beta wall). Observed on a local production build after the fix: ISR routes emit 's-maxage=60, stale-while-revalidate=31535940'; per-request routes emit 'private, no-cache, no-store, max-age=0, must-revalidate'. While the beta wall is up, proxy.ts forces 'private, no-store, max-age=0' on EVERY response (docs/beta-password-wall.md), so a live probe of beta can only assert the walled value (mode 'walled').",
  "hosts": {
    "saoc": {"local_host_header": "saoc.localhost", "live_base": "https://beta.saoc.co.za"},
    "nos": {"local_host_header": "nos.localhost", "live_base": "https://nos.saoc.co.za"}
  },
  "modes": {
    "launched": {
      "isr": {"must_match": "s-maxage=60", "must_not_match": "no-store|private"},
      "dynamic": {"must_match": "no-store", "must_not_match": "s-maxage"},
      "static": {"must_match": "^public, max-age=31536000, immutable$", "must_not_match": "no-store|private|s-maxage"}
    },
    "walled": {
      "all": {"must_match": "private, no-store, max-age=0", "must_not_match": "public|s-maxage|immutable"}
    }
  },
  "routes": {
    "isr": [
      {"host": "saoc", "path": "/"}, {"host": "saoc", "path": "/about"}, {"host": "saoc", "path": "/societies"},
      {"host": "saoc", "path": "/events"}, {"host": "saoc", "path": "/judging"}, {"host": "saoc", "path": "/contact"},
      {"host": "saoc", "path": "/sponsors"},
      {"host": "nos", "path": "/"}, {"host": "nos", "path": "/about"}, {"host": "nos", "path": "/faq"},
      {"host": "nos", "path": "/programme"}, {"host": "nos", "path": "/sponsors"}, {"host": "nos", "path": "/vendors"}
    ],
    "dynamic": [
      {"host": "nos", "path": "/what-to-expect"}, {"host": "nos", "path": "/tickets"}, {"host": "nos", "path": "/workshops"},
      {"host": "nos", "path": "/symposium"}, {"host": "nos", "path": "/conferences"}, {"host": "nos", "path": "/wosa-conference"},
      {"host": "nos", "path": "/tickets/no-such-ticket-f4", "status": 404},
      {"host": "nos", "path": "/vendors/payment?token=bogus", "status": 200}
    ],
    "static": [
      {"host": "saoc", "discover_from": "/", "ext": "css"}, {"host": "saoc", "discover_from": "/", "ext": "js"},
      {"host": "nos", "discover_from": "/", "ext": "css"}, {"host": "nos", "discover_from": "/", "ext": "js"}
    ]
  },
  "selftest_vectors": [
    {"mode": "launched", "class": "isr", "cache_control": "s-maxage=60, stale-while-revalidate=31535940", "expect": "pass"},
    {"mode": "launched", "class": "isr", "cache_control": "private, no-cache, no-store, max-age=0, must-revalidate", "expect": "fail"},
    {"mode": "launched", "class": "isr", "cache_control": null, "expect": "fail"},
    {"mode": "launched", "class": "isr", "cache_control": "public, s-maxage=31536000", "expect": "fail"},
    {"mode": "launched", "class": "dynamic", "cache_control": "private, no-cache, no-store, max-age=0, must-revalidate", "expect": "pass"},
    {"mode": "launched", "class": "dynamic", "cache_control": "s-maxage=60, stale-while-revalidate=31535940", "expect": "fail"},
    {"mode": "walled", "class": "isr", "cache_control": "private, no-store, max-age=0", "expect": "pass"},
    {"mode": "walled", "class": "isr", "cache_control": "s-maxage=60, stale-while-revalidate=31535940", "expect": "fail"},
    {"mode": "launched", "class": "static", "cache_control": "public, max-age=31536000, immutable", "expect": "pass"},
    {"mode": "launched", "class": "static", "cache_control": "public, max-age=31536000", "expect": "fail"},
    {"mode": "launched", "class": "static", "cache_control": "private, no-cache, no-store, max-age=0, must-revalidate", "expect": "fail"},
    {"mode": "launched", "class": "static", "cache_control": "s-maxage=60, stale-while-revalidate=31535940", "expect": "fail"},
    {"mode": "launched", "class": "static", "cache_control": null, "expect": "fail"},
    {"mode": "walled", "class": "static", "cache_control": "private, no-store, max-age=0", "expect": "pass"},
    {"mode": "walled", "class": "static", "cache_control": "public, max-age=31536000, immutable", "expect": "fail"}
  ]
}
