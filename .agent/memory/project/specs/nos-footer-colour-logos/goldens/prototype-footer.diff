diff --git a/components/nos-chrome/nos-chrome.css b/components/nos-chrome/nos-chrome.css
index e74b451a..d1454d78 100644
--- a/components/nos-chrome/nos-chrome.css
+++ b/components/nos-chrome/nos-chrome.css
@@ -133,6 +133,8 @@
 /* The PNG carries transparent padding (measured: 229px left, 250px right, 224px top and 257px bottom of 3272x2876). At the 248px box the negative margins below trim it, so the column hugs the visible ink and the footer gaps and the top line are measured from the artwork, not the box. */
 .nf-lockup { display: block; width: 248px; margin: -16px -19px -19px -17px; line-height: 0; border-radius: 4px; }
 .nf-lockup img { display: block; width: 100%; max-width: none; height: auto; }
+.nf-credit-lockup { display: block; width: 206px; max-width: 100%; line-height: 0; border-radius: 4px; }
+.nf-credit-lockup img { display: block; width: 100%; max-width: none; height: auto; }
 .nf-saoc-credit { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; width: max-content; max-width: 100%; }
 .nf-credit-reg { display: flex; flex-wrap: wrap; column-gap: 16px; row-gap: 0; font: 400 13px/1.4 var(--nc-sans); letter-spacing: 0.08em; color: var(--nc-gold); font-variant-numeric: tabular-nums; text-align: start; }
 .nf-reg-item { white-space: nowrap; }
