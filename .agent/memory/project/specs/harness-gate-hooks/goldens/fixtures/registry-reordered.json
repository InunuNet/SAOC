{
  "schema": "athanor.contract-kinds/v1",
  "kinds": {
    "browser_deployed_check": {
      "script": "execution/browser_deployed_check.sh",
      "timeout_seconds": 200
    },
    "gws_inbox_check": {
      "script": "execution/gws_inbox_check.sh",
      "timeout_seconds": 200
    }
  },
  "gate_hooks": [
    {
      "name": "residue-post",
      "stage": "post",
      "command": [
        "scripts/gate-hooks/residue_hook.py"
      ],
      "on_error": "open",
      "timeout_seconds": 300
    },
    {
      "name": "triad-coverage",
      "stage": "pre",
      "command": [
        "scripts/gate-hooks/triad_hook.py",
        "{contract}"
      ],
      "on_error": "closed",
      "timeout_seconds": 30
    },
    {
      "name": "residue-pre",
      "stage": "pre",
      "command": [
        "scripts/gate-hooks/residue_hook.py"
      ],
      "on_error": "open",
      "timeout_seconds": 300
    }
  ]
}
