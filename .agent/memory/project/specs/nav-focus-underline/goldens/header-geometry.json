{
  "$comment": "HD-1 golden. Targets and tolerances for checks/compare-geometry.mjs; edit numbers here, never in the script. Measurements come from checks/measure-header.js run on both hosts at each width (scroll 0). 'when': full = viewport >= breakpoints.full, menu = breakpoints.row .. full-1, phone = < breakpoints.row, wide = >= breakpoints.row, all. Breakpoints are shared by both hosts and are always changed together (NOS Design ruling (d)). The widths measured are `widths` plus full-1, full, row-1, row. 'pair' = |saoc - nos| <= tol. 'same' = strings equal (fonts differ per host by design, so no family metric). 'target' = value within tol on every host that shows the element. 'hostOnly' restricts a rule to one host. A metric that is null on exactly one host fails; null on both is skipped. Rules carry 'feature': f2 (default) or f3 (HD-1b container); the CLI filters with --feature. 'sameAsMetric' compares two metrics on the same host within tol (content left edge vs lockup left edge).",
  "widths": [
    2056,
    1440,
    1280,
    1024,
    390
  ],
  "crossSiteWidth": 1440,
  "crossSiteTolerance": {
    "headerHeight": 1,
    "brandLeft": 1,
    "brandTop": 1
  },
  "rules": [
    {
      "id": "no-utility-bar",
      "metric": "utilityBars",
      "when": "all",
      "each": 0
    },
    {
      "id": "header-position",
      "metric": "headerPosition",
      "when": "all",
      "same": true
    },
    {
      "id": "bar-max-width",
      "metric": "barMaxWidth",
      "when": "full",
      "pair": 1
    },
    {
      "id": "bar-padding-top",
      "metric": "barPaddingTop",
      "when": "all",
      "pair": 1
    },
    {
      "id": "bar-padding-left",
      "metric": "barPaddingLeft",
      "when": "all",
      "pair": 1
    },
    {
      "id": "bar-gap",
      "metric": "barGap",
      "when": "wide",
      "pair": 1
    },
    {
      "id": "brand-left",
      "metric": "brandLeft",
      "when": "all",
      "pair": 1
    },
    {
      "id": "header-height-pair",
      "metric": "headerHeight",
      "when": "wide",
      "pair": 1
    },
    {
      "id": "header-height-97",
      "metric": "headerHeight",
      "when": "wide",
      "target": 97,
      "tol": 1
    },
    {
      "id": "brand-ink-width-pair",
      "metric": "brandWidth",
      "when": "all",
      "pair": 2
    },
    {
      "id": "brand-ink-width-405",
      "metric": "brandWidth",
      "when": "wide",
      "target": 405,
      "tol": 2
    },
    {
      "id": "brand-fills-first-row",
      "metric": "brandWidth",
      "when": "phone",
      "sameAsMetric": "barContentWidth",
      "tol": 2
    },
    {
      "id": "brand-centred-in-bar",
      "metric": "brandCenterOffset",
      "when": "all",
      "target": 0,
      "tol": 1
    },
    {
      "id": "bar-single-row",
      "metric": "barRows",
      "when": "full",
      "each": 1
    },
    {
      "id": "bar-single-row-menu",
      "metric": "barRows",
      "when": "menu",
      "each": 1
    },
    {
      "id": "bar-two-rows-phone",
      "metric": "barRows",
      "when": "phone",
      "each": 2
    },
    {
      "id": "nav-single-line",
      "metric": "navSingleLine",
      "when": "full",
      "each": true
    },
    {
      "id": "item-height-44",
      "metric": "itemHeightMin",
      "when": "full",
      "target": 44,
      "tol": 0
    },
    {
      "id": "item-height-44-max",
      "metric": "itemHeightMax",
      "when": "full",
      "target": 44,
      "tol": 0
    },
    {
      "id": "item-font-size",
      "metric": "itemFontSize",
      "when": "full",
      "same": true
    },
    {
      "id": "item-font-weight",
      "metric": "itemFontWeight",
      "when": "full",
      "same": true
    },
    {
      "id": "item-line-height",
      "metric": "itemLineHeight",
      "when": "full",
      "same": true
    },
    {
      "id": "item-letter-spacing",
      "metric": "itemLetterSpacing",
      "when": "full",
      "same": true
    },
    {
      "id": "item-text-transform",
      "metric": "itemTextTransform",
      "when": "full",
      "same": true
    },
    {
      "id": "item-padding-x",
      "metric": "itemPaddingLeft",
      "when": "full",
      "pair": 1
    },
    {
      "id": "item-gap",
      "metric": "itemGap",
      "when": "full",
      "pair": 1
    },
    {
      "id": "cta-height-44",
      "metric": "ctaHeight",
      "when": "all",
      "target": 44,
      "tol": 1
    },
    {
      "id": "cta-right-edge",
      "metric": "ctaRight",
      "when": "wide",
      "pair": 1
    },
    {
      "id": "cta-right-inset",
      "metric": "ctaRightInset",
      "when": "wide",
      "pair": 1
    },
    {
      "id": "cta-padding-y",
      "metric": "ctaPaddingTop",
      "when": "all",
      "pair": 1
    },
    {
      "id": "cta-padding-x",
      "metric": "ctaPaddingLeft",
      "when": "all",
      "pair": 1
    },
    {
      "id": "cta-radius",
      "metric": "ctaRadius",
      "when": "all",
      "same": true
    },
    {
      "id": "cta-font-size",
      "metric": "ctaFontSize",
      "when": "all",
      "same": true
    },
    {
      "id": "cta-font-weight",
      "metric": "ctaFontWeight",
      "when": "all",
      "same": true
    },
    {
      "id": "cta-line-height",
      "metric": "ctaLineHeight",
      "when": "all",
      "same": true
    },
    {
      "id": "cta-letter-spacing",
      "metric": "ctaLetterSpacing",
      "when": "all",
      "same": true
    },
    {
      "id": "cta-text-transform",
      "metric": "ctaTextTransform",
      "when": "all",
      "same": true
    },
    {
      "id": "search-width-44",
      "metric": "searchWidth",
      "when": "full",
      "target": 44,
      "tol": 0,
      "hostOnly": "saoc"
    },
    {
      "id": "search-height-44",
      "metric": "searchHeight",
      "when": "full",
      "target": 44,
      "tol": 0,
      "hostOnly": "saoc"
    },
    {
      "id": "menu-height",
      "metric": "menuHeight",
      "when": "menu",
      "target": 44,
      "tol": 1
    },
    {
      "id": "menu-height-phone",
      "metric": "menuHeight",
      "when": "phone",
      "target": 44,
      "tol": 1
    },
    {
      "id": "menu-label",
      "metric": "menuText",
      "when": "all",
      "same": true
    },
    {
      "id": "active-bar-offset",
      "metric": "activeBarBottom",
      "when": "full",
      "same": true
    },
    {
      "id": "active-bar-height",
      "metric": "activeBarHeight",
      "when": "full",
      "same": true
    },
    {
      "id": "active-bar-is-8px-2px",
      "metric": "activeBarBottom",
      "when": "full",
