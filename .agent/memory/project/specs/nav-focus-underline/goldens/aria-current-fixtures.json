{
  "$comment": "Golden for lib/nav-current.ts. 'matcher' rows drive isNavCurrent(pathname, href). 'saoc' and 'nos' rows drive the real nav data (components/chrome/nav-config.ts NAV + CONTACT_LINK; components/nos-chrome/nos-nav.ts NOS_NAV + NOS_CONTACT_PATH): for each route, the set of item ids whose navAriaCurrent(...) is 'page' (leaves) or whose anyNavCurrent(...) is true (groups) must equal the listed ids exactly. Item ids are the ids in those files; 'hub' is the NOS brand link (href /national-show), 'contact' is the NOS contact link (href /national-show/contact). The SAOC 'national-show' item is a crossSite link and is never current on the SAOC host.",
  "matcher": [
    { "pathname": "/", "href": "/", "expected": true, "note": "home is exact only" },
    { "pathname": "/about", "href": "/", "expected": false, "note": "home never matches a child route" },
    { "pathname": "/about", "href": "/about", "expected": true },
    { "pathname": "/about/", "href": "/about", "expected": true, "note": "trailing slash ignored" },
    { "pathname": "/about/team", "href": "/about", "expected": true, "note": "parent of a child route" },
    { "pathname": "/aboutus", "href": "/about", "expected": false, "note": "segment boundary, not a string prefix" },
    { "pathname": "/eventsfoo", "href": "/events", "expected": false, "note": "the old startsWith() matched this" },
    { "pathname": "/about?x=1", "href": "/about", "expected": true, "note": "query on the pathname ignored" },
    { "pathname": "/tickets", "href": "/national-show/tickets#ticket-day", "expected": true, "note": "hash on the href ignored; internal href matches public NOS path" },
    { "pathname": "/ABOUT", "href": "/about", "expected": false, "note": "routing is case-sensitive" },
    { "pathname": null, "href": "/about", "expected": false },
    { "pathname": "", "href": "/about", "expected": false },
    { "pathname": "/", "href": "/national-show", "expected": true, "note": "NOS hub: public form" },
    { "pathname": "/national-show", "href": "/national-show", "expected": true, "note": "NOS hub: internal form (host-less dev origin)" },
    { "pathname": "/national-show", "href": "/", "expected": true, "note": "internal hub path equals the public hub href after normalising" },
    { "pathname": "/faq", "href": "/national-show/faq", "expected": true, "note": "public pathname, internal href" },
    { "pathname": "/national-show/faq", "href": "/faq", "expected": true, "note": "internal pathname, public href" },
    { "pathname": "/national-show/faq", "href": "/national-show/faq", "expected": true },
    { "pathname": "/faq", "href": "/national-show", "expected": false, "note": "hub is exact only" },
    { "pathname": "/about", "href": "https://nos.saoc.co.za/", "expected": false, "note": "absolute (cross-site) hrefs are never current" },
    { "pathname": "/about", "href": "//nos.saoc.co.za/about", "expected": false, "note": "protocol-relative hrefs are never current" }
  ],
  "saoc": {
    "$comment": "Current-item ids per pathname on the SAOC host.",
    "routes": [
      { "pathname": "/", "current": [] },
      { "pathname": "/about", "current": ["about"] },
      { "pathname": "/about/", "current": ["about"] },
      { "pathname": "/societies", "current": ["societies"] },
      { "pathname": "/societies/orchid-society-of-pretoria", "current": ["societies"] },
      { "pathname": "/judging", "current": ["judging"] },
      { "pathname": "/events", "current": ["events"] },
      { "pathname": "/events/submit", "current": ["events"] },
      { "pathname": "/events/some-show", "current": ["events"] },
      { "pathname": "/eventsfoo", "current": [] },
      { "pathname": "/aboutus", "current": [] },
      { "pathname": "/sponsors", "current": ["sponsors"] },
      { "pathname": "/contact", "current": ["contact-link"] },
      { "pathname": "/media-kit", "current": [] },
      { "pathname": "/members", "current": [] },
      { "pathname": "/privacy", "current": [] },
      { "pathname": "/national-show", "current": [], "note": "crossSite item: never current on the SAOC host" }
    ]
  },
  "nos": {
    "$comment": "Current leaf ids and current disclosure-group ids per pathname on the NOS host. Group ids are the NOS_NAV column ids (visit, programme, exhibit-trade).",
    "routes": [
      { "pathname": "/", "leaves": ["hub"], "groups": [] },
      { "pathname": "/national-show", "leaves": ["hub"], "groups": [], "note": "host-less dev origin" },
      { "pathname": "/about", "leaves": ["about-the-show"], "groups": ["visit"] },
      { "pathname": "/what-to-expect", "leaves": ["what-to-expect"], "groups": ["visit"] },
      { "pathname": "/plan-your-visit", "leaves": ["plan-your-visit"], "groups": ["visit"] },
      { "pathname": "/plan-your-visit/parking", "leaves": ["plan-your-visit"], "groups": ["visit"], "note": "child route marks its parent" },
      { "pathname": "/faq", "leaves": ["faq"], "groups": ["visit"] },
      { "pathname": "/national-show/faq", "leaves": ["faq"], "groups": ["visit"], "note": "internal form" },
      { "pathname": "/programme", "leaves": ["programme"], "groups": ["programme"] },
      { "pathname": "/workshops", "leaves": ["workshops"], "groups": ["programme"] },
      { "pathname": "/symposium", "leaves": ["symposium"], "groups": ["programme"] },
      { "pathname": "/wosa-conference", "leaves": ["wosa-conference"], "groups": ["programme"] },
      { "pathname": "/conferences", "leaves": ["conferences"], "groups": ["programme"] },
      { "pathname": "/sa-exhibitors", "leaves": ["sa-exhibitors"], "groups": ["exhibit-trade"] },
      { "pathname": "/international-guests", "leaves": ["international-guests"], "groups": ["exhibit-trade"] },
      { "pathname": "/exhibitors", "leaves": ["exhibitors"], "groups": ["exhibit-trade"], "note": "not sa-exhibitors: segment boundary" },
      { "pathname": "/vendors", "leaves": ["vendors"], "groups": ["exhibit-trade"] },
      { "pathname": "/vendors/apply", "leaves": ["vendors"], "groups": ["exhibit-trade"] },
      { "pathname": "/tickets", "leaves": ["tickets"], "groups": [] },
      { "pathname": "/tickets/confirmation", "leaves": ["tickets"], "groups": [] },
      { "pathname": "/national-show/tickets", "leaves": ["tickets"], "groups": [] },
      { "pathname": "/sponsors", "leaves": ["show-sponsors"], "groups": [] },
      { "pathname": "/archive", "leaves": ["past-shows"], "groups": [] },
      { "pathname": "/contact", "leaves": ["contact"], "groups": [] },
      { "pathname": "/faqs", "leaves": [], "groups": [] },
      { "pathname": "/privacy", "leaves": [], "groups": [] }
    ]
  }
}
