{
  "_doc": "Truth table for isTicketOnSale(). Each case: start from baseDoc/baseInput, shallow-merge doc/input, delete the named doc keys, call, compare. reason precedence: demo, inactive, sales-closed, wrong-show, no-price, no-capacity, sold-out. now is an ISO string; the check converts it to Date.",
  "baseDoc": {
    "slug": "weekend-pass",
    "active": true,
    "demo": false,
    "price": 380,
    "regularPrice": null,
    "earlyBirdCutoff": null,
    "capacity": 300,
    "releasedQuantity": null,
    "show": {
      "_ref": "show-19-2027"
    }
  },
  "baseInput": {
    "activeShowId": "show-19-2027",
    "salesOpen": true,
    "soldOut": false,
    "now": "2026-10-25T10:00:00Z",
    "qaFixturesAllowed": false
  },
  "cases": [
    {
      "name": "baseline sellable product",
      "doc": {},
      "input": {},
      "delete": [],
      "expect": {
        "onSale": true,
        "reason": null
      }
    },
    {
      "name": "demo flag true is refused",
      "doc": {
        "demo": true
      },
      "input": {},
      "delete": [],
      "expect": {
        "onSale": false,
        "reason": "demo"
      }
    },
    {
      "name": "reserved demo slug without the flag is refused",
      "doc": {
        "slug": "demo-general-admission"
      },
      "input": {},
      "delete": [],
      "expect": {
        "onSale": false,
        "reason": "demo"
      }
    },
    {
      "name": "the real qa fixture shape is refused in production policy",
      "doc": {
        "slug": "qa-fixture-ticket",
        "demo": true,
        "price": 0,
        "capacity": 50
      },
      "input": {},
      "delete": [],
      "expect": {
        "onSale": false,
        "reason": "demo"
      }
    },
    {
      "name": "demo is allowed only when the qa policy allows it",
      "doc": {
        "demo": true
      },
      "input": {
        "qaFixturesAllowed": true
      },
      "delete": [],
      "expect": {
        "onSale": true,
        "reason": null
      }
    },
    {
      "name": "qa policy waives demo and nothing else: sales closed still refuses",
