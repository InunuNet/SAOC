# Firebase client SDK (public — safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only — keep secret)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Resend email provider (server-only — keep secret)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_ADDRESS=SAOC <noreply@saoc.co.za>

# Sanity CMS (project ID + dataset are public — safe to expose)
NEXT_PUBLIC_SANITY_PROJECT_ID=26yfbug4
NEXT_PUBLIC_SANITY_DATASET=production

# PayFast sandbox (server-only). The universal test credentials are published at
# https://developers.payfast.co.za/docs#sandbox — or create your own sandbox account at
# https://sandbox.payfast.co.za. Values are deliberately not committed here.
PAYFAST_SANDBOX_MERCHANT_ID=
PAYFAST_SANDBOX_MERCHANT_KEY=
PAYFAST_SANDBOX_PASSPHRASE=

# Origin used to build the PayFast return / cancel / notify URLs. Must be a public https
# origin — PayFast posts the ITN callback to it, so localhost can never receive one.
# Defaults to https://saoc.co.za, which still points at the OLD Joomla site: override this
# for any sandbox testing.
SITE_URL=

# Sanity server-only secrets (keep out of client bundle)
SANITY_API_READ_TOKEN=
SANITY_API_TOKEN=
SANITY_WEBHOOK_SECRET=
SANITY_REVALIDATE_SECRET=
