# Firebase client SDK (public — safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only — keep secret)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Admin gate allowlist (server-only). Comma-separated email addresses permitted to hold
# the `admin` custom claim. Missing/empty means nobody is admin — fail closed, never
# "allow all". See lib/admin-auth.ts.
ADMIN_EMAIL_ALLOWLIST=

# Resend email provider (server-only — keep secret). Sending domains are segregated by
# category (see lib/email.ts) rather than shared.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_TICKETS=SAOC Tickets <tickets@tickets.saoc.co.za>
RESEND_FROM_FORMS=SAOC <noreply@forms.saoc.co.za>

# Sanity CMS (project ID + dataset are public — safe to expose)
NEXT_PUBLIC_SANITY_PROJECT_ID=26yfbug4
NEXT_PUBLIC_SANITY_DATASET=production

# PayFast sandbox (server-only). The universal test credentials are published at
# https://developers.payfast.co.za/docs#sandbox — or create your own sandbox account at
# https://sandbox.payfast.co.za. Values are deliberately not committed here.
PAYFAST_SANDBOX_MERCHANT_ID=
PAYFAST_SANDBOX_MERCHANT_KEY=
PAYFAST_SANDBOX_PASSPHRASE=

# Origin used to build PayFast return/cancel/notify URLs and email recovery links.
# Must be a public https origin — PayFast posts the ITN callback to it, so localhost
# can never receive one. Defaults to https://saoc.co.za (old Joomla site): override this
# for any sandbox testing. Provided by Firebase App Hosting at runtime, not build time.
SITE_URL=

# Server-only HMAC secret for signing order-recovery tokens (lib/recovery-token.ts).
# Generate a genuinely random, high-entropy value distinct from every PayFast credential
# and from SANITY_WEBHOOK_SECRET/SANITY_REVALIDATE_SECRET — sharing a secret across
# purposes lets whoever holds the other one forge recovery tokens. Checkout fails closed
# (500, before any Firestore write) if this is unset.
RECOVERY_TOKEN_SECRET=

# Vendor gated-registration-flow (mission vendor-gated-registration-flow F3) -- signs the
# single-use registration token minted on vendor application approval and re-verified server-
# side by the gated POST /api/vendors/register route. A NEW, purpose-scoped secret -- never
# reuses RECOVERY_TOKEN_SECRET above (a different trust domain: order recovery vs. vendor
# registration gating). Fails closed (generic "invalid or expired" response) if this is unset.
VENDOR_REGISTRATION_TOKEN_SECRET=

# Vendor gated-registration-flow M3 (F27) -- signs the stand-payment token minted when a
# committee approves a full vendor submission, and re-verified by every payment-page/route use
# site. A THIRD, purpose-scoped secret -- never shared with VENDOR_REGISTRATION_TOKEN_SECRET
# above or RECOVERY_TOKEN_SECRET (a distinct trust domain: stand payment vs. registration
# gating vs. order recovery). Unlike VENDOR_REGISTRATION_TOKEN_SECRET, this token is NOT
# single-use -- every use site re-checks the submission's current state instead.
VENDOR_STAND_PAYMENT_TOKEN_SECRET=

# Sanity server-only secrets (keep out of client bundle)
SANITY_API_READ_TOKEN=
SANITY_API_TOKEN=
SANITY_WEBHOOK_SECRET=
SANITY_REVALIDATE_SECRET=

# Bearer secret for POST /api/admin/reconcile-orders (server-only). Cloud Scheduler sends
# this as `Authorization: Bearer <value>`. Missing/empty means the route fails closed
# (401) — never "no auth required". See docs/order-reconciliation.md.
RECONCILIATION_CRON_SECRET=

# Recipient for the stranded-order reconciliation alert email (server-only). Defaults to
# info@saoc.co.za if unset — see docs/order-reconciliation.md.
RECONCILIATION_ALERT_EMAIL=
