# Lee-Ann Drive mirror — Spec V3 contains plaintext mailbox passwords (Section: Email Collection Checklist)
documents/from-leeann-drive/

# Locally-trusted dev certificates (mkcert) — never commit private keys
.certs/

# Playwright CLI session state (browser QA agents)
.playwright-cli/

# ---- Generated door test-ticket QR sheet (F6) -- regenerated by `pnpm door:seed` ----
scripts/output/

# Run-time generated mutation scratch (contracts/checks/payment-seam-f2/check-reject-path-mutations.sh)
contracts/checks/**/_mutants/

# QA agent scratch (debug scripts, session state, screenshots) — local-only, never committed
.qa_scratch/
# Transient agent worktrees — never commit (they get recorded as bogus gitlinks)
# Transient F5 containment-test bait dir; created and torn down by
# goldens/verify_gate_sweep_isolation.py, must never be committed
.agent/memory/project/specs/repo-wide-gate-sweep/goldens/fixture_specs_f5r2/escape-bait/

# Raw .docx bytes downloaded by execution/drive_docx_sync.py -- regenerable
# from Drive on demand, bulky, useless binary diffs in review. The parsed
# content.md, manifest.json, and index.json alongside them ARE tracked.
content/drive-source/**/source.docx
# Same treatment for content/drive-recovered/ (national-show-ia-alignment, M1) --
# hand-salvaged content.md and recovery.json are tracked; any .docx copied in
# alongside them is not.
content/drive-recovered/**/*.docx
# Pruner recovery bin (platform-scoped-delivery D2). Every prune is a MOVE
# into .agent/trash/prune-<UTC>/, so a real prune leaves a full copy of every
# pruned file here — untracked content that `git add -A` would otherwise
# commit straight back into the repo the prune just removed it from.
.agent/trash/
# The workspace-identity affirmation (copied-project-halt D-2). Records THIS
# machine's absolute path for THIS project, so it must never be tracked: a
# `git clone` carrying one would launder a copy, and two machines would fight
# over one file holding two different absolute paths.
.agent/.identity_binding.json
# ---- NOS design evidence: keep committed webp, ignore heavy source PNGs ----
.agent/evidence/**/*.png

# SECURITY (2026-09-10): client-supplied Drive documents can contain live secrets.
# Lee-Ann's spec doc carried plaintext mailbox passwords and reached the PUBLIC repo
# once already (commit 1d6512cb) — see .agent/memory/project/needs-human.md.
# Ignored wholesale so `git add -A` cannot re-commit it. Do not un-ignore without a
# secret scan; the sync tool re-derives this tree on demand.
content/drive-source/
