    {
      "name": "19th show 23-26 Sept, UTC midnight (the reported defect)",
      "input": {
        "slug": "show-19",
        "title": "Show, 19th",
        "start": "2027-09-23T00:00:00Z",
        "end": "2027-09-26T00:00:00Z",
        "venue": "The Hangar",
        "location": "Stellenbosch"
      },
      "expectedLines": [
        "BEGIN:VEVENT",
        "UID:show-19@saoc.co.za",
        "DTSTART;VALUE=DATE:20270923",
        "DTEND;VALUE=DATE:20270927",
        "SUMMARY:Show\\, 19th",
        "LOCATION:The Hangar\\, Stellenbosch",
        "END:VEVENT"
      ]
    },
